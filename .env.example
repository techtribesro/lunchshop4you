# SQLite file path (relative to app working dir, or absolute path to a Fly volume mount)
DATABASE_PATH=./data/lunchshop.db

# Gmail IMAP bot account (app-specific password, not the real account password)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_USER=lunchbot@example.com
GMAIL_IMAP_PASSWORD=

# Sender address the weekly menu email arrives from (used to filter the inbox)
MENU_EMAIL_SENDER=menu-provider@example.com

# Google Sheets reporting mirror
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Session cookie signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=change-me

# Admin account, provisioned/re-synced automatically on every app startup --
# no CLI command needed. Set these and restart to get an admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Order cutoff time, 24h HH:MM, interpreted in Europe/Prague local time
ORDER_CUTOFF_TIME=11:30

# Optional: Gemini API key (Google AI Studio) for LLM-based menu PDF
# extraction and daily order-summary email copy. If unset, the regex/
# heuristic menu parser and a plain fallback greeting are used instead.
GEMINI_API_KEY=

# Daily order summary email, sent Mon-Fri shortly after the cutoff (uses the
# Gmail SMTP credentials above -- same account/app password as IMAP).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
ORDER_SUMMARY_RECIPIENT_EMAIL=
ORDER_SUMMARY_RECIPIENT_NAME=Honza
ORDER_SUMMARY_SENDER_NAME=Lunchshop4you
ORDER_SUMMARY_SEND_TIME=11:35
